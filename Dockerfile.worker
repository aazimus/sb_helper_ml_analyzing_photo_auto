FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# 1. Системные зависимости
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq-dev \
        gcc \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 2. ML-зависимости ПЕРВЫМИ — они меняются редко, будут закэшированы
COPY requirements-ml.txt /tmp/requirements-ml.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements-ml.txt

# 3. Базовые зависимости Django/Celery — меняются чаще
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# 4. Копируем проект
COPY . /app

RUN chmod +x /app/entrypoint-worker.sh

# Запуск от непривилегированного пользователя
RUN useradd -m -u 1000 celeryuser && chown -R celeryuser /app
USER celeryuser

WORKDIR /app/backend

ENTRYPOINT ["/app/entrypoint-worker.sh"]
CMD ["celery", "-A", "cheking_number_car", "worker", "-l", "info", "--concurrency=2"]
