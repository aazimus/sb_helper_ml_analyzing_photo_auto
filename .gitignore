# ---------------------------------------------------------
# Виртуальное окружение и кэш Python
# ---------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------------------------------------------------------
# База данных Django (если это тестовая SQLite)
# ---------------------------------------------------------
db.sqlite3

# ---------------------------------------------------------
# ML: веса моделей (YOLO .pt, CRNN .pth) — НЕ хранить в Git
# ---------------------------------------------------------
models/*.pt
models/*.pth
models/*.onnx

# Если папка models целиком не должна быть в Git — раскомментируй строку ниже:
# models/

# ---------------------------------------------------------
# Медиа и картинки (кропы номеров, исходные фото)
# ---------------------------------------------------------
media/
uploads/
data/
datasets/
tests/emul_max_group/*.png
tests/emul_max_group/*.jpg
tests/emul_max_group/*.jpeg
tests/emul_max_group/*.bmp

# Если хочешь игнорировать всю папку целиком — раскомментируй:
# tests/emul_max_group/

# ---------------------------------------------------------
# CSV-файлы разметки (train/val/test) — выбирай один вариант
# ---------------------------------------------------------

# ВАРИАНТ 1 (РЕКОМЕНДУЕМЫЙ): не хранить CSV в Git (чтобы не раздувать историю)
training/*.csv

# ВАРИАНТ 2 (если CSV маленькие и нужны в репозитории):
# закомментируй строку выше и оставь CSV как есть.
# Тогда они будут попадать в коммиты.

# ---------------------------------------------------------
# Временные/копии скриптов (твои test_pipeline copy.py и аналоги)
# ---------------------------------------------------------
*copy.py
*_copy.py
*-copy.py
backup_*.py
old_*.py

# ---------------------------------------------------------
# Логи, временные файлы, IDE
# ---------------------------------------------------------
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.pytest_cache/

# ---------------------------------------------------------
# Миграции Django (опционально)
# ---------------------------------------------------------
# Если миграции генерируются автоматически и ты используешь CI/CD,
# можно игнорировать все миграции, кроме __init__.py:
*/migrations/*.py
!*/migrations/__init__.py