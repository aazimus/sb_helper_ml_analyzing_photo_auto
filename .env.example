# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# === Настройки Django ===
SECRET_KEY=замените_на_длинную_случайную_строку
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,ваш-домен.com

# === База данных (PostgreSQL) ===
DB_HOST=db
DB_PORT=5432
DB_NAME=car_db
DB_USER=car_user
DB_PASSWORD=замените_на_надёжный_пароль

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0
